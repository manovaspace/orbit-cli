.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-pr - Manage pull requests and automated delivery


.SH SYNOPSIS
\fBorbit pr [flags]\fP


.SH DESCRIPTION
Create, merge, inspect status, and deliver pull requests directly from your workspace repository.


.SH OPTIONS
\fB--dir\fP="."
	Path to repository directory (default: current directory)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for pr


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file


.SH SEE ALSO
\fBorbit(1)\fP, \fBorbit-pr-create(1)\fP, \fBorbit-pr-deliver(1)\fP, \fBorbit-pr-merge(1)\fP, \fBorbit-pr-status(1)\fP
