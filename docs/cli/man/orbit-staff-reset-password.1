.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
.PP
orbit-staff-reset-password - Rotate the LLDAP password used for staff SSO and mailbox sign-in


.SH SYNOPSIS
.PP
\fBorbit staff reset-password  [flags]\fP


.SH DESCRIPTION
.PP
Rotate the LLDAP password used for staff SSO and mailbox sign-in


.SH OPTIONS
.PP
\fB-h\fP, \fB--help\fP[=false]
	help for reset-password

.PP
\fB--ldap\fP[=false]
	reset the shared LLDAP password used for SSO and mail

.PP
\fB--mailbox\fP[=false]
	deprecated alias for the shared LLDAP password


.SH OPTIONS INHERITED FROM PARENT COMMANDS
.PP
\fB--config\fP=""
	Custom path to Orbit CLI configuration file

.PP
\fB--owner-store\fP=""
	path to owner.json vault

.PP
\fB--server\fP=""
	staff server URL (or ORBIT_STAFF_URL)


.SH SEE ALSO
.PP
\fBorbit-staff(1)\fP
