.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
.PP
orbit-staff-reset-password - Rotate ldap and/or mailbox passwords, optionally Authelia TOTP


.SH SYNOPSIS
.PP
\fBorbit staff reset-password  [flags]\fP


.SH DESCRIPTION
.PP
Rotate ldap and/or mailbox passwords, optionally Authelia TOTP


.SH OPTIONS
.PP
\fB-h\fP, \fB--help\fP[=false]
	help for reset-password

.PP
\fB--ldap\fP[=false]
	reset SSO/ldap password

.PP
\fB--mailbox\fP[=false]
	reset mailbox password

.PP
\fB--totp\fP[=false]
	replace Authelia TOTP and print otpauth


.SH OPTIONS INHERITED FROM PARENT COMMANDS
.PP
\fB--owner-store\fP=""
	path to owner.json vault

.PP
\fB--server\fP=""
	staff server URL (or ORBIT_STAFF_URL)


.SH SEE ALSO
.PP
\fBorbit-staff(1)\fP
