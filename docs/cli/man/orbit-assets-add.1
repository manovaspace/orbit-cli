.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-assets-add - Hash, upload, and gitignore a file; update orbit-assets.yaml


.SH SYNOPSIS
\fBorbit assets add  [flags]\fP


.SH DESCRIPTION
Hash, upload, and gitignore a file; update orbit-assets.yaml


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for add

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file


.SH SEE ALSO
\fBorbit-assets(1)\fP
