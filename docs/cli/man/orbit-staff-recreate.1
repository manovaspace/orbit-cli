	legacy flag; ignored because recreate is disabled

.PP
\fB--invite\fP[=false]
	legacy flag; ignored because recreate is disabled

.PP
\fB--invite-email\fP=""
	legacy flag; ignored because recreate is disabled

.PP
\fB--invite-ttl\fP="7d"
	legacy flag; ignored because recreate is disabled

.PP
\fB--name\fP=""
	legacy flag; ignored because recreate is disabled

.PP
