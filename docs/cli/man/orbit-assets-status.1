.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-assets-status - Show missing or mismatched local assets


.SH SYNOPSIS
\fBorbit assets status [scope] [flags]\fP


.SH DESCRIPTION
Show missing or mismatched local assets


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for status

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope

.PP
\fB--manifest\fP=""
	Path to workspace.yaml


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file


.SH SEE ALSO
\fBorbit-assets(1)\fP
