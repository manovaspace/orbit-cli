.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-audit-upstream - Report OSV advisories and toolchain versions behind upstream


.SH SYNOPSIS
\fBorbit audit upstream [flags]\fP


.SH DESCRIPTION
Report OSV advisories and toolchain versions behind upstream


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for upstream

.PP
\fB--remote\fP[=false]
	Read OSV, the npm registry and GitHub releases


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file

.PP
\fB--json\fP[=false]
	Print the report as a JSON envelope


.SH SEE ALSO
\fBorbit-audit(1)\fP
