.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-audit-deps - Report resolved dependency versions, forbidden ranges and shadowed exports


.SH SYNOPSIS
\fBorbit audit deps [pkg] [flags]\fP


.SH DESCRIPTION
Report resolved dependency versions, forbidden ranges and shadowed exports


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for deps

.PP
\fB--remote\fP[=false]
	Read the public npm registry for the latest published version


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file

.PP
\fB--json\fP[=false]
	Print the report as a JSON envelope


.SH SEE ALSO
\fBorbit-audit(1)\fP
