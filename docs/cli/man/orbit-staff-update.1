.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
.PP
orbit-staff-update - Update display name, forward, or groups


.SH SYNOPSIS
.PP
\fBorbit staff update  [flags]\fP


.SH DESCRIPTION
.PP
Update display name, forward, or groups


.SH OPTIONS
.PP
\fB--forward\fP=""
	personal forward email

.PP
\fB--groups\fP=""
	comma-separated groups

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--name\fP=""
	display name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
.PP
\fB--owner-store\fP=""
	path to owner.json vault

.PP
\fB--server\fP=""
	staff server URL (or ORBIT_STAFF_URL)


.SH SEE ALSO
.PP
\fBorbit-staff(1)\fP
