.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-staff-update - Update display name, profile names, forward, or groups


.SH SYNOPSIS
\fBorbit staff update  [flags]\fP


.SH DESCRIPTION
Update display name, profile names, forward, or groups


.SH OPTIONS
\fB--first-name\fP=""
	first name

.PP
\fB--forward\fP=""
	personal forward email

.PP
\fB--groups\fP=""
	comma-separated groups

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope

.PP
\fB--last-name\fP=""
	last name

.PP
\fB--name\fP=""
	display name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file

.PP
\fB--owner-store\fP=""
	path to owner.json vault

.PP
\fB--server\fP=""
	staff server URL (or ORBIT_STAFF_URL)


.SH SEE ALSO
\fBorbit-staff(1)\fP
