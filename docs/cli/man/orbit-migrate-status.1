.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-migrate-status - Show status of all registered workspace migrations


.SH SYNOPSIS
\fBorbit migrate status [flags]\fP


.SH DESCRIPTION
Show status of all registered workspace migrations


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for status

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope

.PP
\fB--limit\fP=0
	maximum rows per page (0 = all)

.PP
\fB--page\fP=1
	page number to display


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file


.SH SEE ALSO
\fBorbit-migrate(1)\fP
