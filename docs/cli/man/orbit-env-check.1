.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-env-check - Validate project .env files against their .env.schema.yaml contracts


.SH SYNOPSIS
\fBorbit env check [path] [flags]\fP


.SH DESCRIPTION
Validate project .env files against their .env.schema.yaml contracts


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for check

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file


.SH SEE ALSO
\fBorbit-env(1)\fP
