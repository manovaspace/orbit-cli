.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-assets-push - Upload index objects that are missing from R2


.SH SYNOPSIS
\fBorbit assets push [scope] [flags]\fP


.SH DESCRIPTION
Upload index objects that are missing from R2


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for push

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope

.PP
\fB--manifest\fP=""
	Path to workspace.yaml


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file


.SH SEE ALSO
\fBorbit-assets(1)\fP
