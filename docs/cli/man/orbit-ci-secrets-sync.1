.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-ci-secrets-sync - Set every ci_secrets entry for one repo, or every repo that declares any


.SH SYNOPSIS
\fBorbit ci secrets sync [repo] [flags]\fP


.SH DESCRIPTION
Set every ci_secrets entry for one repo, or every repo that declares any


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for sync

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope

.PP
\fB--keys-dir\fP="~/.config/orbit/deploy-keys"
	Directory holding per-repo DEPLOY_SSH_KEY files

.PP
\fB--source\fP="/home/opmc/.config/orbit/ci-secrets.env"
	KEY=value file with secret values (chmod 600)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file

.PP
\fB--manifest\fP=""
	Path to workspace.yaml


.SH SEE ALSO
\fBorbit-ci-secrets(1)\fP
