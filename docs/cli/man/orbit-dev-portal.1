.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-dev-portal - Open or print the local developer portal URL


.SH SYNOPSIS
\fBorbit dev portal [flags]\fP


.SH DESCRIPTION
Open or print the local developer portal URL


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for portal

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file


.SH SEE ALSO
\fBorbit-dev(1)\fP
