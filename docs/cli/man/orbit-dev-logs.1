.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-dev-logs - Stream logs from local dev stack containers


.SH SYNOPSIS
\fBorbit dev logs [service] [flags]\fP


.SH DESCRIPTION
Stream logs from local dev stack containers


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for logs

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file


.SH SEE ALSO
\fBorbit-dev(1)\fP
