.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
.PP
orbit-staff-list - List staff members


.SH SYNOPSIS
.PP
\fBorbit staff list [flags]\fP


.SH DESCRIPTION
.PP
List staff members


.SH OPTIONS
.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list


.SH OPTIONS INHERITED FROM PARENT COMMANDS
.PP
\fB--config\fP=""
	Custom path to Orbit CLI configuration file

.PP
\fB--owner-store\fP=""
	path to owner.json vault

.PP
\fB--server\fP=""
	staff server URL (or ORBIT_STAFF_URL)


.SH SEE ALSO
.PP
\fBorbit-staff(1)\fP
