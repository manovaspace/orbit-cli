.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-staff-list - List staff members


.SH SYNOPSIS
\fBorbit staff list [flags]\fP


.SH DESCRIPTION
List staff members


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope

.PP
\fB--limit\fP=0
	maximum rows per page (0 = all)

.PP
\fB--page\fP=1
	page number to display


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file

.PP
\fB--owner-store\fP=""
	path to owner.json vault

.PP
\fB--server\fP=""
	staff server URL (or ORBIT_STAFF_URL)


.SH SEE ALSO
\fBorbit-staff(1)\fP
