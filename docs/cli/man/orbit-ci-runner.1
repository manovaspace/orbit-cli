.nh
.TH "ORBIT" "1" "Aug 2026" "Orbit Developer Platform" "Orbit Platform Manual"

.SH NAME
orbit-ci-runner - Set CI_RUNNER on private repos and report the self-hosted pool


.SH SYNOPSIS
\fBorbit ci runner vps|github|status [flags]\fP


.SH DESCRIPTION
Set CI_RUNNER on private repos and report the self-hosted pool


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for runner

.PP
\fB--json\fP[=false]
	Print the result as a JSON envelope

.PP
\fB--manifest\fP=""
	Path to workspace.yaml


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Custom path to Orbit CLI configuration file


.SH SEE ALSO
\fBorbit-ci(1)\fP
